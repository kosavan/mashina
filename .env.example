# Local HTTP preview. Remote access must use HTTPS.
MASHINA_BIND=127.0.0.1
MASHINA_PORT=8000
MASHINA_ORIGIN=http://localhost:8000
MASHINA_SECURE_COOKIES=0
MASHINA_BACKUP_KEEP=7
# Optional scoped API. Restart after changing; disabled by default.
MASHINA_API_ENABLED=0
# HTTPS example:
# MASHINA_ORIGIN=https://garage.example.com
# MASHINA_SECURE_COOKIES=1

# Optional notifications; leave blank to keep Telegram disabled.
# Web Push contact URI: a real mailto: address or HTTPS page; defaults to MASHINA_ORIGIN.
MASHINA_VAPID_SUBJECT=
MASHINA_TELEGRAM_BOT_TOKEN=
MASHINA_TELEGRAM_BOT_USERNAME=
